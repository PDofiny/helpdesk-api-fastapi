# Copie para ".env" (cp .env.example .env) e ajuste. NUNCA versione o .env.
ENVIRONMENT=development

# --- PostgreSQL (usado pelo container "db" do docker-compose) ---
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change_me
POSTGRES_DB=helpdesk

# --- Aplicação ---
# Execução local (fora do Docker): o banco é exposto em localhost:5432.
# Dentro do docker-compose esta variável é sobrescrita para apontar para o host "db".
# Se a senha tiver caracteres especiais (@ : / # %), aplique URL-encoding.
DATABASE_URL=postgresql+asyncpg://helpdesk:change_me@localhost:5432/helpdesk

# OBRIGATÓRIA (mín. 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Permite POST /auth/register sem autenticação (cria apenas contas de cliente)
ALLOW_PUBLIC_REGISTRATION=true

# Primeiro administrador (python -m app.scripts.create_admin)
FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
